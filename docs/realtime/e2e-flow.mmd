sequenceDiagram
    autonumber

    box Mobile — UI
        participant Screen as BreathSessionScreen
        participant VM as BreathViewModel
        participant SM as BreathSessionStateMachine
    end

    box Mobile — Module Layer
        participant BMSC as BreathModuleStateChannel
        participant BMIS as BreathModuleInstructionStream
    end

    box Mobile — Core gRPC
        participant GCM as GrpcConnectionManager
        participant MSC as ModuleStateChannel
        participant MIS as ModuleInstructionStream
    end

    box gRPC bidi streams
        participant PROTO_STATE as TrackActivity
        participant PROTO_INSTR as StreamData
    end

    box Backend — NestJS
        participant CTRL as ModuleStateGrpcController
        participant ICTRL as ModuleInstructionStreamGrpcController
        participant AE as ActivityEngine
        participant SE as StreamEngine
    end

    box Backend — PostgreSQL
        participant DB_MS as module_sessions
        participant DB_SS as session_stream_samples
    end

    %% 0. Connection setup

    note over GCM: UserNotifier emits AuthenticatedState
    GCM ->> GCM: connect() — GrpcConnectionState.connected
    GCM -->> MSC: connectionState = connected
    MSC ->> PROTO_STATE: trackActivity() — open bidi stream
    note over MIS: lazy — stream opens on first emit()

    %% 1. User taps Play (first time — start)

    Screen ->> VM: resume()
    VM ->> SM: resume()
    SM -->> VM: state{status: breath}
    VM -->> BMSC: stream: BreathSessionState{status: breath}

    note over BMSC: _started=false, wasPaused+isActive<br/>_handleLifecycle calls channel.start()
    BMSC ->> MSC: start(type: breath, refId: sessionId)
    note over MSC: _isPendingStart = true
    MSC ->> PROTO_STATE: StateRequest{activityStart:<br/>type:BREATH, refId}

    PROTO_STATE ->> CTRL: ActivityStartCmd
    CTRL ->> AE: startActivity(userId, activityType, activityRefId)
    AE ->> DB_MS: INSERT module_sessions<br/>{status:active, startedAt:now}
    DB_MS -->> AE: moduleSessionId (UUID)
    AE ->> SE: push(moduleSessionId, SESSION_STARTED)
    AE -->> CTRL: ModuleSession{id, status:ACTIVE}
    CTRL ->> PROTO_STATE: StateResponse{status:ACTIVE,<br/>moduleSessionId, isPaused:false}

    PROTO_STATE -->> MSC: StateResponse{status:ACTIVE, moduleSessionId}
    note over MSC: _isPendingStart=false<br/>state = ModuleState{active, moduleSessionId}
    MSC -->> BMSC: channel.state: ModuleState{moduleSessionId}
    note over BMSC: _moduleSessionId set, _flushPending() called

    %% 2. Phase change — instruction sample

    SM -->> VM: state{phase: exhale, intervalMs: 6000}
    VM -->> BMSC: stream: BreathSessionState{phase: exhale}

    note over BMSC: phaseChanged=true, moduleSessionId known<br/>_handleInstruction calls sendSample()
    BMSC ->> BMIS: sendSample(moduleSessionId, "exhale", 6000)
    BMIS ->> MIS: emit(InstructionSample{sessionId,<br/>phase:"exhale", durationMs:6000,<br/>moduleId:"breath",<br/>instructionType:"breath_phase"})

    note over MIS: _streamSink==null, _openStream()
    MIS ->> PROTO_INSTR: streamData() — open bidi stream
    MIS ->> PROTO_INSTR: StreamSample{sessionId, timestamp,<br/>moduleId:"breath",<br/>instructionType:"breath_phase",<br/>data:{phase:"exhale", durationMs:6000}}

    PROTO_INSTR ->> ICTRL: StreamSample
    note over ICTRL: validate: session active, not paused
    ICTRL ->> SE: push(sessionId, sample)
    note over SE: buffered in-memory (max 200KB/session)
    SE -->> ICTRL: PushResult{receivedCount, droppedCount}
    ICTRL ->> PROTO_INSTR: StreamResponse{ack:{receivedCount,<br/>droppedCount, maxSamplesPerSecond}}
    PROTO_INSTR -->> MIS: StreamResponse{ack}
    MIS -->> BMIS: acks: InstructionAck

    note over SE: periodic flush every 5s
    SE ->> DB_SS: INSERT session_stream_samples<br/>{moduleSessionId, samples:[...], flushedAt:now}

    %% 3. User taps Pause

    Screen ->> VM: pause()
    VM ->> SM: pause()
    SM -->> VM: state{status: pause}
    VM -->> BMSC: stream: BreathSessionState{status: pause}

    note over BMSC: wasActive, status==pause<br/>_handleLifecycle calls channel.pause()
    BMSC ->> MSC: pause()
    note over MSC: _isPendingPause = true
    MSC ->> PROTO_STATE: StateRequest{activityPause: ActivityPauseCmd}

    PROTO_STATE ->> CTRL: ActivityPauseCmd
    CTRL ->> AE: pauseActivity(userId)
    note over AE: state.isPaused = true (in-memory)
    AE ->> SE: push(moduleSessionId, SESSION_PAUSED)
    CTRL ->> PROTO_STATE: StateResponse{status:ACTIVE, isPaused:true}

    PROTO_STATE -->> MSC: StateResponse{status:ACTIVE, isPaused:true}
    MSC -->> BMSC: events: ModuleSessionPaused

    note over ICTRL: breath_phase samples rejected while isPaused=true

    %% 4. User taps Play again — resume

    Screen ->> VM: resume()
    VM ->> SM: resume()
    SM -->> VM: state{status: breath}
    VM -->> BMSC: stream: BreathSessionState{status: breath}

    note over BMSC: _started=true, wasPaused+isActive<br/>_handleLifecycle calls channel.unpause()
    BMSC ->> MSC: unpause()
    MSC ->> PROTO_STATE: StateRequest{activityResume: ActivityResumeCmd}

    PROTO_STATE ->> CTRL: ActivityResumeCmd
    CTRL ->> AE: unpauseActivity(userId)
    note over AE: state.isPaused = false (in-memory)
    CTRL ->> PROTO_STATE: StateResponse{status:ACTIVE, isPaused:false}

    PROTO_STATE -->> MSC: StateResponse{status:ACTIVE, isPaused:false}
    MSC -->> BMSC: events: ModuleSessionUnpaused

    %% 5. Session complete

    SM -->> VM: state{status: complete}
    VM -->> BMSC: stream: BreathSessionState{status: complete}

    note over BMSC: status==complete, _started=true, _ended=false<br/>_handleLifecycle calls channel.end(), _ended=true
    BMSC ->> MSC: end()
    MSC ->> PROTO_STATE: StateRequest{activityEnd: ActivityEndCmd}

    PROTO_STATE ->> CTRL: ActivityEndCmd
    CTRL ->> AE: endActivity(userId)
    AE ->> DB_MS: UPDATE module_sessions<br/>SET status=completed, endedAt=now
    AE ->> SE: push(moduleSessionId, SESSION_ENDED)
    note over SE: OnEvent(SessionEvents.COMPLETED) — flush immediately
    SE ->> DB_SS: INSERT session_stream_samples<br/>{moduleSessionId, samples:[remaining...]}
    SE ->> SE: clearBuffer(moduleSessionId)

    CTRL ->> PROTO_STATE: StateResponse{status:COMPLETED, moduleSessionId}
    PROTO_STATE -->> MSC: StateResponse{status:COMPLETED}
    MSC -->> BMSC: events: ModuleSessionEnded
    MSC -->> BMSC: state: ModuleState.initial() — idle

    note over DB_MS,DB_SS: moduleSessionId links module_sessions and session_stream_samples.<br/>Future biometric data will join on the same moduleSessionId.
